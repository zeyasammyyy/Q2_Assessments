        "# Lists of roblox games and their ratings\n",
        "roblox_games = [\"Tower of Hell\", \"Murder Mystery\", \"Flee the Facility\", \"Pet Store Tycoon\", \"Adopt Me\"]\n",
        "game_ratings = [92, 88, 95, 89, 90]\n",
        "\n",
        "# Displays all games with their index and rating\n",
        "def display_games(games, ratings):\n",
        "    print(\"\\n--- Current Roblox Games List ---\")\n",
        "    for i in range(len(games)):\n",
        "      print(f\"Game #{i+1} (Index {i}): {games[i]} - Rating: {ratings[i]}\")\n",
        "\n",
        "# Looks for a specific game in the list\n",
        "def search_game(games, ratings, target_game):\n",
        "    if target_game in games:\n",
        "      idx = games.index(target_game)\n",
        "      print(f\" '{target_game}' found at Game #{idx+1} (Index {idx}) with a rating of {ratings[idx]}.\")\n",
        "    else:\n",
        "      print(f\" '{target_game}' not found in your Roblox list.\")\n",
        "\n",
        "# Gets average, highest, and lowest ratings\n",
        "def compute_statistics(games, ratings):\n",
        "    if not ratings:\n",
        "        print(\"No game ratings available.\")\n",
        "        return\n",
        "    avg = sum(ratings) / len(ratings)\n",
        "    highest_idx = ratings.index(max(ratings))\n",
        "    lowest_idx = ratings.index(min(ratings))\n",
        "\n",
        "    print(\"\\n--- Roblox Games Statistics ---\")\n",
        "    print(f\"Total Games Tracked: {len(games)}\")\n",
        "    print(f\"Average Game Rating:  {avg:.2f}\")\n",
        "    print(f\"Highest Rated Game:  {games[highest_idx]} ({max(ratings)})\")\n",
        "    print(f\"Lowest Rated Game:   {games[lowest_idx]} ({min(ratings)})\")\n",
        "\n",
        "# Replaces a game and its rating using the index\n",
        "def update_game(games, ratings, index, new_game, new_rating):\n",
        "    if 0 <= index < len(games):\n",
        "        old_game = games[index]\n",
        "        old_rating = ratings[index]\n",
        "        games[index] = new_game\n",
        "        ratings[index] = new_rating\n",
        "        print(f\" Updated Index {index}: {old_game} ({old_rating}) -> {new_game} ({new_rating})\")\n",
        "    else:\n",
        "        print(f\" Invalid index! Must be between 0 and {len(games)-1}.\")\n",
        "\n",
        "def run_mini_app():\n",
        "    print(\"=== Welcome to Roblox Games Analyzer ===\")\n",
        "    display_games(roblox_games, game_ratings)\n",
        "    compute_statistics(roblox_games, game_ratings)\n",
        "\n",
        "    print(\"\\n--- Performing Search ---\")\n",
        "    search_game(roblox_games, game_ratings, \"Flee the Facility\")\n",
        "\n",
        "    print(\"\\n--- Updating a Game ---\")\n",
        "    update_game(roblox_games, game_ratings, 3, \"Brookhaven\", 91)\n",
        "\n",
        "    display_games(roblox_games, game_ratings)\n",
        "\n",
        "# Run the Mini-App\n",
        "run_mini_app()"
      ]
